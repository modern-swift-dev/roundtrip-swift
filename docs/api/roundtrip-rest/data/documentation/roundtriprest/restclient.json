ce(),","    headerProvider: Headers(),","    errorSubject: PassthroughSubject<ApiError, Never>()",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"code":"execute(request:validStatusCode:)","type":"codeVoice"},{"type":"text","text":" for an "},{"code":"ApiResponse","type":"codeVoice"},{"type":"text","text":" or give Swift a "},{"code":"Decodable","type":"codeVoice"},{"type":"text","text":" result type to receive an "},{"code":"ApiOperationResult","type":"codeVoice"},{"type":"text","text":". The default valid status code is 200."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtriprest\/restclient"]}],"hierarchy":{"paths":[["doc:\/\/RoundTripREST\/documentation\/RoundTripREST"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/RESTClient"},"references":{"doc://RoundTripREST/documentation/RoundTripREST/CancellationAndConcurrency":{"role":"article","abstract":[{"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"isActive":true,"type":"reference"}],"kind":"article","type":"topic","url":"\/documentation\/roundtriprest\/cancellationandconcurrency","title":"REST cancellation and concurrency","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/CancellationAndConcurrency"},"doc://RoundTripREST/documentation/RoundTripREST":{"url":"\/documentation\/roundtriprest","kind":"symbol","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","role":"collection","title":"RoundTripREST","abstract":[{"text":"Build API clients on top of RoundTrip’s request and transfer types.","type":"text"}],"type":"topic"},"doc://RoundTripREST/documentation/RoundTripREST/ErrorsAndDecoding":{"role":"article","abstract":[{"overridingTitleInlineContent":[{"type":"text","text":"Documentation