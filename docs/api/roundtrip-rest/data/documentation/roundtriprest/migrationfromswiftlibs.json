{"identifier":{"url":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/MigrationFromSwiftLibs","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/RoundTripREST\/documentation\/RoundTripREST"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtriprest\/migrationfromswiftlibs"]}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"RoundTripREST extracts the REST library previously shipped as "},{"type":"codeVoice","code":"SLREST"},{"type":"text","text":" in SwiftLibs. It depends on the separate "},{"type":"codeVoice","code":"RoundTrip"},{"type":"text","text":" HTTP product."}],"type":"paragraph"},{"code":["\/\/ Before","import SLHttp","import SLREST","","\/\/ After","import RoundTrip","import RoundTripREST"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"roundtrip-swift"},{"type":"text","text":" package dependency, then replace the SwiftLibs products with "},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"type":"text","text":" and "},{"type":"codeVoice","code":".product(name: \"RoundTripREST\", package: \"roundtrip-swift\")"},{"type":"text","text":". The main REST names stay the same: "},{"type":"codeVoice","code":"RestClient"},{"type":"text","text":", "},{"type":"codeVoice","code":"NetworkService"},{"type":"text","text":", "},{"type":"codeVoice","code":"BaseURLProvider"},{"type":"text","text":", "},{"type":"codeVoice","code":"ApiKeyProvider"},{"type":"text","text":", and "},{"type":"codeVoice","code":"DefaultHttpHeaderProvider"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"RoundTripREST supports Apple platforms only. Remove Linux targets that used "},{"type":"codeVoice","code":"SLREST"},{"type":"text","text":" before moving to the extracted package."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The REST provider, service, and client protocols now conform to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", so implementations must satisfy Swift 6 concurrency checking. WebSocket factories are main-actor isolated. "},{"type":"codeVoice","code":"NetworkService"},{"type":"text","text":" and its session delegate are final, and the delegate’s header subject is immutable; replace subclasses with protocol-based wrappers or injected implementations of "},{"type":"codeVoice","code":"NetworkServiceProtocol"},{"type":"text","text":"."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"RoundTripREST"}],"role":"article","title":"Migrating from SLREST"},"seeAlsoSections":[{"identifiers":["doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/Testing"],"anchor":"Development","title":"Development","generated":true}],"abstract":[{"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","type":"reference","overridingTitle":"Documentation index","isActive":true}],"references":{"doc://RoundTripREST/documentation/RoundTripREST":{"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","title":"RoundTripREST","url":"\/documentation\/roundtriprest","role":"collection","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Build API clients on top of RoundTrip’s request and transfer types."}]},"doc://RoundTripREST/documentation/RoundTripREST/Testing":{"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/Testing","title":"Testing REST clients","url":"\/documentation\/roundtriprest\/testing","role":"article","kind":"article","type":"topic","abstract":[{"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","type":"reference","overridingTitle":"Documentation index","isActive":true}]}}}