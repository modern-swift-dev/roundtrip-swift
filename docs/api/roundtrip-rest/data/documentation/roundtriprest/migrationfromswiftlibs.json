{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"RoundTripREST extracts the REST library previously shipped as "},{"type":"codeVoice","code":"SLREST"},{"type":"text","text":" in SwiftLibs. It depends on the separate "},{"type":"codeVoice","code":"RoundTrip"},{"type":"text","text":" HTTP product."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Before","import SLHttp","import SLREST","","\/\/ After","import RoundTrip","import RoundTripREST"]},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"roundtrip-swift","type":"codeVoice"},{"text":" package dependency, then replace the SwiftLibs products with ","type":"text"},{"code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".product(name: \"RoundTripREST\", package: \"roundtrip-swift\")","type":"codeVoice"},{"text":". The main REST names stay the same: ","type":"text"},{"code":"RestClient","type":"codeVoice"},{"text":", ","type":"text"},{"code":"NetworkService","type":"codeVoice"},{"text":", ","type":"text"},{"code":"BaseURLProvider","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ApiKeyProvider","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"DefaultHttpHeaderProvider","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"RoundTripREST supports Apple platforms only. Remove Linux targets that used ","type":"text"},{"code":"SLREST","type":"codeVoice"},{"text":" before moving to the extracted package.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The REST provider, service, and client protocols now conform to "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", so implementations must satisfy Swift 6 concurrency checking. WebSocket factories are main-actor isolated. "},{"code":"NetworkService","type":"codeVoice"},{"type":"text","text":" and its session delegate are final, and the delegate’s header subject is immutable; replace subclasses with protocol-based wrappers or injected implementations of "},{"code":"NetworkServiceProtocol","type":"codeVoice"},{"type":"text","text":"."}]}]}],"variants":[{"paths":["\/documentation\/roundtriprest\/migrationfromswiftlibs"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Development","identifiers":["doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/Testing"],"generated":true,"title":"Development"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"RoundTripREST"}],"title":"Migrating from SLREST"},"hierarchy":{"paths":[["doc:\/\/RoundTripREST\/documentation\/RoundTripREST"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/MigrationFromSwiftLibs","interfaceLanguage":"swift"},"abstract":[{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"overridingTitle":"Documentation index","type":"reference","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST"}],"references":{"doc://RoundTripREST/documentation/RoundTripREST/Testing":{"url":"\/documentation\/roundtriprest\/testing","role":"article","type":"topic","kind":"article","title":"Testing REST clients","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/Testing","abstract":[{"isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index","type":"reference","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST"}]},"doc://RoundTripREST/documentation/RoundTripREST":{"title":"RoundTripREST","type":"topic","url":"\/documentation\/roundtriprest","abstract":[{"type":"text","text":"Build API clients on top of RoundTrip’s request and transfer types."}],"kind":"symbol","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","role":"collection"}}}