{"abstract":[{"type":"reference","overridingTitle":"Documentation index","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"isActive":true}],"metadata":{"title":"Migrating from SLREST","modules":[{"name":"RoundTripREST"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"RoundTripREST extracts the REST library previously shipped as "},{"code":"SLREST","type":"codeVoice"},{"type":"text","text":" in SwiftLibs. It depends on the separate "},{"code":"RoundTrip","type":"codeVoice"},{"type":"text","text":" HTTP product."}]},{"type":"codeListing","code":["\/\/ Before","import SLHttp","import SLREST","","\/\/ After","import RoundTrip","import RoundTripREST"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"roundtrip-swift","type":"codeVoice"},{"type":"text","text":" package dependency, then replace the SwiftLibs products with "},{"code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")","type":"codeVoice"},{"type":"text","text":" and "},{"code":".product(name: \"RoundTripREST\", package: \"roundtrip-swift\")","type":"codeVoice"},{"type":"text","text":". The main REST names stay the same: "},{"code":"RestClient","type":"codeVoice"},{"type":"text","text":", "},{"code":"NetworkService","type":"codeVoice"},{"type":"text","text":", "},{"code":"BaseURLProvider","type":"codeVoice"},{"type":"text","text":", "},{"code":"ApiKeyProvider","type":"codeVoice"},{"type":"text","text":", and "},{"code":"DefaultHttpHeaderProvider","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"RoundTripREST supports Apple platforms only. Remove Linux targets that used "},{"code":"SLREST","type":"codeVoice"},{"type":"text","t