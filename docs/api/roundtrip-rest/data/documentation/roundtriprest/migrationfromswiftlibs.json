{"abstract":[{"type":"reference","isActive":true,"overridingTitle":"Documentation index","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST"}],"metadata":{"title":"Migrating from SLREST","modules":[{"name":"RoundTripREST"}],"role":"article","roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Development","identifiers":["doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/Testing"],"anchor":"Development"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtriprest\/migrationfromswiftlibs"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/RoundTripREST\/documentation\/RoundTripREST"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/MigrationFromSwiftLibs"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"RoundTripREST extracts the REST library previously shipped as ","type":"text"},{"type":"codeVoice","code":"SLREST"},{"text":" in SwiftLibs. It depends on the separate ","type":"text"},{"type":"codeVoice","code":"RoundTrip"},{"text":" HTTP product.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Before","import SLHttp","import SLREST","","\/\/ After","import RoundTrip","import RoundTripREST"]},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"roundtrip-swift"},{"text":" package dependency, then replace the SwiftLibs products with ","type":"text"},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".product(name: \"RoundTripREST\", package: \"roundtrip-swift\")"},{"text":". The main REST names stay the same: ","type":"text"},{"type":"codeVoice","code":"RestClient"},{"text":", ","type":"text"},{"type":"codeVoice","code":"NetworkService"},{"text":", ","type":"text"},{"type":"codeVoice","code":"BaseURLProvider"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ApiKeyProvider"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"DefaultHttpHeaderProvider"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"RoundTripREST supports Apple platforms only. Remove Linux targets that used ","type":"text"},{"type":"codeVoice","code":"SLREST"},{"text":" before moving to the extracted package.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The REST provider, service, and client protocols now conform to ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", so implementations must satisfy Swift 6 concurrency checking. WebSocket factories are main-actor isolated. ","type":"text"},{"type":"codeVoice","code":"NetworkService"},{"text":" and its session delegate are final, and the delegate’s header subject is immutable; replace subclasses with protocol-based wrappers or injected implementations of ","type":"text"},{"type":"codeVoice","code":"NetworkServiceProtocol"},{"text":".","type":"text"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://RoundTripREST/documentation/RoundTripREST":{"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","role":"collection","type":"topic","url":"\/documentation\/roundtriprest","title":"RoundTripREST","kind":"symbol","abstract":[{"type":"text","text":"Build API clients on top of RoundTrip’s request and transfer types."}]},"doc://RoundTripREST/documentation/RoundTripREST/Testing":{"abstract":[{"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","isActive":true,"overridingTitle":"Documentation index"}],"kind":"article","role":"article","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/Testing"