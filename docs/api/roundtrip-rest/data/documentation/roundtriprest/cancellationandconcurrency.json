{"metadata":{"modules":[{"name":"RoundTripREST"}],"title":"REST cancellation and concurrency","role":"article","roleHeading":"Article"},"sections":[],"kind":"article","abstract":[{"isActive":true,"type":"reference","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"generated":true,"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/RESTClient","doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/ErrorsAndDecoding"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RestClient"},{"type":"text","text":" from async tasks and propagate cancellation from the caller. A cancelled URLSession operation may surface as "},{"type":"codeVoice","code":"ApiError.cancelled"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URLError.cancelled"},{"type":"text","text":" depending on the operation path."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NetworkService.cancelAll()"},{"type":"text","text":" cancels all tasks in that service’s session. "},{"type":"codeVoice","code":"invalidate()"},{"type":"text","text":" also invalidates the session. Give separate features separate services when their cancellation lifetimes differ."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The error publisher is a Combine value. Keep its subscriptions alive for as long as the observer needs them, and deliver UI changes on the main actor."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtriprest\/cancellationandconcurrency"]}],"hierarchy":{"paths":[["doc:\/\/RoundTripREST\/documentation\/R