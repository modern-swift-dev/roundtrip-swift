{"metadata":{"role":"article","modules":[{"name":"RoundTripREST"}],"roleHeading":"Article","title":"REST errors and decoding"},"sections":[],"kind":"article","abstract":[{"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"isActive":true,"type":"reference"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/RESTClient","doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/CancellationAndConcurrency"],"generated":true}],"primaryContentSections":[{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/RestClient","isActive":true,"type":"reference"},{"type":"text","text":" checks the status codes passed in "},{"code":"validStatusCode","type":"codeVoice"},{"type":"text","text":" before decoding. It throws "},{"code":"ApiError.invalidStatusCode","type":"codeVoice"},{"type":"text","text":" for an unexpected response and "},{"code":"ApiError.responseDecodingFailed","type":"codeVoice"},{"type":"text","text":" when JSON decoding fails."}],"type":"paragraph"},{"code":["struct User: Decodable {","    let id: Int","    let name: String","}","","do {","    let result: ApiOperationResult<User> = try await client.execute(","        request: UserRequest(id: 42),","        validStatusCode: [200]","    )","    print(result.value.name)","} catch let error as ApiError {","    switch error {","    case let .invalidStatusCode(status, _):","        print(\"Unexpected status: \\(status)\")","    case let .responseDecodingFailed(data, underlying):","        print(\"Could not decode \\(data?.count ?? 0) bytes: \\(underlying)\")","    default:","        throw error","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineC