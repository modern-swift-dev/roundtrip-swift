{"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/RoundTripREST\/documentation\/RoundTripREST"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/RESTClient","doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/CancellationAndConcurrency"],"anchor":"Essentials","title":"Essentials"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtriprest\/errorsanddecoding"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/RoundTripREST\/documentation\/RoundTripREST\/RestClient","isActive":true},{"type":"text","text":" checks the status codes passed in "},{"type":"codeVoice","code":"validStatusCode"},{"type":"text","text":" before decoding. It throws "},{"type":"codeVoice","code":"ApiError.invalidStatusCode"},{"type":"text","text":" for an unexpected response and "},{"type":"codeVoice","code":"ApiError.responseDecodingFailed"},{"type":"text","text":" when JSON decoding fails."}],"type":"paragraph"},{"syntax":"swift","code":["struct User: Decodable {","    let id: Int","    let name: String","}","","do {","    let result: ApiOperationResult<User> = try await client.execute(","        request: UserRequest(id: 42),","        validStatusCode: [200]","    )","    print(result.value.name)","} catch let error as ApiError {","    switch error {","    case let .invalidStatusCode(status, _):","        print(\"Unexpected status: \\(status)\")","    case let .responseDecodingFailed(data, underlying):","        print(\"Could not decode \\(data?.count ?? 0) bytes: \\(underlying)\")","    default:","        throw error","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Subscribe to the error subject passed to "},{"type":"codeVoice","code":"RestClient"},{"type":"text","text":" if the app needs to ob