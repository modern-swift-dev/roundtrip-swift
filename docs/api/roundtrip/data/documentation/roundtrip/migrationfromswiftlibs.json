{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"RoundTrip extracts the HTTP library previously shipped as ","type":"text"},{"type":"codeVoice","code":"SLHttp"},{"text":" in SwiftLibs. Update imports and target dependencies first:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Before","import SLHttp","","\/\/ After","import RoundTrip"]},{"type":"paragraph","inlineContent":[{"text":"The primary HTTP types keep their names: ","type":"text"},{"type":"codeVoice","code":"HttpClient"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URLRequestBuilder"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URLRequestConvertible"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MultipartBody"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ApiResponse"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"ApiError"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Move the RoundTrip checkout into your package dependencies, replace ","type":"text"},{"type":"codeVoice","code":".product(name: \"SLHttp\", package: \"SwiftLibs\")"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"RoundTrip"},{"text":" product, and update tests to import ","type":"text"},{"type":"codeVoice","code":"RoundTrip"},{"text":". The extracted package supports Apple platforms only, so remove any Linux target that depended on ","type":"text"},{"type":"codeVoice","code":"SLHttp"},{"text":" before adopting it.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/migrationfromswiftlibs"]}],"abstract":[{"type":"reference","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index"}],"identifier":{"interface