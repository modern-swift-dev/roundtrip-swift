{"abstract":[{"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","overridingTitle":"Documentation index","type":"reference","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"isActive":true}],"identifier":{"url":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/MigrationFromSwiftLibs","interfaceLanguage":"swift"},"sections":[],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"RoundTrip"}],"title":"Migrating from SLHttp"},"hierarchy":{"paths":[["doc:\/\/RoundTrip\/documentation\/RoundTrip"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/migrationfromswiftlibs"]}],"kind":"article","seeAlsoSections":[{"title":"Development","identifiers":["doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing"],"generated":true,"anchor":"Development"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"RoundTrip extracts the HTTP library previously shipped as "},{"type":"codeVoice","code":"SLHttp"},{"type":"text","text":" in SwiftLibs. Update imports and target dependencies first:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Before","import SLHttp","","\/\/ After","import RoundTrip"]},{"inlineContent":[{"type":"text","text":"The primary HTTP types keep their names: "},{"type":"codeVoice","code":"HttpClient"},{"type":"text","text":", "},{"type":"codeVoice","code":"URLRequestBuilder"},{"type":"text","text":", "},{"type":"codeVoice","code":"URLRequestConvertible"},{"type":"text","text":", "},{"type":"codeVoice","code":"MultipartBody"},{"type":"text","text":", "},{"type":"codeVoice","code":"ApiResponse"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ApiError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add RoundTrip as a package dependency, replace "},{"type":"codeVoice","code":".product(name: \"SLHttp\", package: \"SwiftLibs\")"},{"type":"text","text":" with "},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"type":"text","text":", and update tests to import "},{"type":"codeVoice","code":"RoundTrip"},{"type":"text","text":". The extracted package supports Apple platforms only, so remove any Linux target that depended on "},{"type":"codeVoice","code":"SLHttp"},{"type":"text","text":" before adopting it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"RoundTrip uses Swift 6 concurrency checking. "},{"type":"codeVoice","code":"WSSClient"},{"type":"text","text":", its factory methods, "},{"type":"codeVoice","code":"BackgroundHttpClient.init"},{"type":"text","text":", and "},{"type":"codeVoice","code":"BackgroundHttpClient.finishedTask"},{"type":"text","text":" are main-actor isolated. Call them from "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" code or cross to the main actor with "},{"type":"codeVoice","code":"await MainActor.run"},{"type":"text","text":". "},{"type":"codeVoice","code":"ApiError"},{"type":"text","text":" no longer conforms to SwiftLibs’ "},{"type":"codeVoice","code":"CapturableError"},{"type":"text","text":"; add that conformance in your application if it still uses the SwiftLibs logging protocol."}],"type":"paragraph"}]}],"references":{"doc://RoundTrip/documentation/RoundTrip/Testing":{"title":"Testing with mocked URL loading","kind":"article","abstract":[{"isActive":true,"type":"reference","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"overridingTitle":"Documentation index","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip"}],"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing","url":"\/documentation\/roundtrip\/testing","type":"topic","role":"article"},"doc://RoundTrip/documentation/RoundTrip":{"kind":"symbol","abstract":[{"text":"Build requests and perform HTTP transfers on Apple platforms.","type":"text"}],"type":"topic","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","title":"RoundTrip","role":"collection","url":"\/documentation\/roundtrip"}}}