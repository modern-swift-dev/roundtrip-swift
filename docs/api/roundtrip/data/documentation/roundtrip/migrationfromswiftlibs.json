{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"RoundTrip extracts the HTTP library previously shipped as "},{"type":"codeVoice","code":"SLHttp"},{"type":"text","text":" in SwiftLibs. Update imports and target dependencies first:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Before","import SLHttp","","\/\/ After","import RoundTrip"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The primary HTTP types keep their names: "},{"type":"codeVoice","code":"HttpClient"},{"type":"text","text":", "},{"type":"codeVoice","code":"URLRequestBuilder"},{"type":"text","text":", "},{"type":"codeVoice","code":"URLRequestConvertible"},{"type":"text","text":", "},{"type":"codeVoice","code":"MultipartBody"},{"type":"text","text":", "},{"code":"ApiResponse","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ApiError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add RoundTrip as a package dependency, replace "},{"type":"codeVoice","code":".product(name: \"SLHttp\", package: \"SwiftLibs\")"},{"type":"text","text":" with "},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"type":"text","text":", and update tests to import "},{"type":"codeVoice","code":"RoundTrip"},{"type":"text","text":". The extracted package supports Apple platforms only, so remove any Linux target that depended on "},{"type":"codeVoice","code":"SLHttp"},{"text":" before adopting it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"RoundTrip uses Swift 6 concurrency checking. ","type":"text"},{"type":"codeVoice","code":"WSSClient"},{"text":", its factory methods, ","type":"text"},{"type":"codeVoice","code":"BackgroundHttpClient.init"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"BackgroundHttpClient.finishedTask"},{"text":" are main-actor isolated. Call them from ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" code or cross to the main actor with ","type":"text"},{"type":"codeVoice","code":"await MainActor.run"},{"text":". ","type":"text"},{"type":"codeVoice","code":"ApiError"},{"text":" no longer conforms to SwiftLibs’ ","type":"text"},{"type":"codeVoice","code":"CapturableError"},{"text":"; add that conformance in your application if it still uses the SwiftLibs logging protocol.","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"title":"Development","generated":true,"anchor":"Development","identifiers":["doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/MigrationFromSwiftLibs","interfaceLanguage":"swift"},"kind":"article","abstract":[{"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"overridingTitle":"Documentation index","type":"reference","isActive":true}],"metadata":{"role":"article","modules":[{"name":"RoundTrip"}],"roleHeading":"Article","title":"Migrating from SLHttp"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/migrationfromswiftlibs"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/RoundTrip\/documentation\/RoundTrip"]]},"references":{"doc://RoundTrip/documentation/RoundTrip":{"role":"collection","type":"topic","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","title":"RoundTrip","kind":"symbol","url":"\/documentation\/roundtrip","abstract":[{"text":"Build requests and perform HTTP transfers on Apple platforms.","type":"text"}]},"doc://RoundTrip/documentation/RoundTrip/Testing":{"title":"Testing with mocked URL loading","type":"topic","url":"\/documentation\/roundtrip\/testing","abstract":[{"type":"reference","overridingTitle":"Documentation index","isActive":true,"identifier":"doc:\/\/RoundTrip\/docu