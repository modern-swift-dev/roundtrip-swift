{"metadata":{"roleHeading":"Article","modules":[{"name":"RoundTrip"}],"role":"article","title":"Migrating from SLHttp"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/migrationfromswiftlibs"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","isActive":true,"overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"type":"reference","overridingTitle":"Documentation index"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"RoundTrip extracts the HTTP library previously shipped as ","type":"text"},{"code":"SLHttp","type":"codeVoice"},{"text":" in SwiftLibs. Update imports and target dependencies first:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Before","import SLHttp","","\/\/ After","import RoundTrip"]},{"type":"paragraph","inlineContent":[{"text":"The primary HTTP types keep their names: ","type":"text"},{"code":"HttpClient","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URLRequestBuilder","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URLRequestConvertible","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MultipartBody","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ApiResponse","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"ApiError","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Add RoundTrip as a package dependency, replace ","type":"text"},{"type":"codeVoice","code":".product(name: \"SLHttp\", package: \"SwiftLibs\")"},{"text":" with ","type":"text"},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"text":", and update tests to import ","type":"text"},{"type":"codeVoice","code":"RoundTrip"},{"text":". The extracted package supports Apple platforms only, so remove any Linux target that depended on ","type":"text"},{"code":"SLHttp","type":"codeVoice"},{"text":" before adopting it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"RoundTrip uses Swift 6 concurrency checking. ","type":"text"},{"code":"WSSClient","type":"codeVoice"},{"text":", its factory methods, ","type":"text"},{"code":"BackgroundHttpClient.init","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"BackgroundHttpClient.finishedTask","type":"codeVoice"},{"text":" are main-actor isolated. Call them from ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" code or cross to the main actor with ","type":"text"},{"code":"await MainActor.run","type":"codeVoice"},{"text":". ","type":"text"},{"code":"ApiError","type":"codeVoice"},{"text":" no longer conforms to SwiftLibs’ ","type":"text"},{"code":"CapturableError","type":"codeVoice"},{"text":"; add that conformance in your application if it still uses the SwiftLibs logging protocol.","type":"text"}]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"title":"Development","generated":true,"anchor":"Development","identifiers":["doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing"]}],"hierarchy":{"paths":[["doc:\/\/RoundTrip\/documentation\/RoundTrip"]]},"identifier":{"url":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/MigrationFromSwiftLibs","interfaceLanguage":"swift"},"references":{"doc://RoundTrip/documentation/RoundTrip":{"role":"collection","title":"RoundTrip","type":"topic","abstract":[{"type":"text","text":"Build requests and perform HTTP transfers on Apple platforms."}],"kind":"symbol","url":"\/documentation\/roundtrip","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip"},"doc://RoundTrip/documentation/RoundTrip/Testing":{"role":"article","kind":"article","url":"\/documentation\/roundtrip\/testing","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing","title":"Testing with mocked URL loading","type":"topic","abstract":[{"isActive"