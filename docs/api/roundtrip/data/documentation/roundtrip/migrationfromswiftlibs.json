:"codeVoice"},{"text":" before adopting it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"RoundTrip uses Swift 6 concurrency checking. ","type":"text"},{"code":"WSSClient","type":"codeVoice"},{"type":"text","text":", its factory methods, "},{"code":"BackgroundHttpClient.init","type":"codeVoice"},{"type":"text","text":", and "},{"code":"BackgroundHttpClient.finishedTask","type":"codeVoice"},{"text":" are main-actor isolated. Call them from ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" code or cross to the main actor with "},{"code":"await MainActor.run","type":"codeVoice"},{"type":"text","text":". "},{"code":"ApiError","type":"codeVoice"},{"text":" no longer conforms to SwiftLibs’ ","type":"text"},{"code":"CapturableError","type":"codeVoice"},{"text":"; add that conformance in your application if it still uses the SwiftLibs logging protocol.","type":"text"}]}]}],"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing"],"title":"Development","anchor":"Development"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"RoundTrip"}],"title":"Migrating from SLHttp"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/migrationfromswiftlibs"]}],"references":{"doc://RoundTrip/documentation/RoundTrip/Testing":{"title":"Testing with mocked URL loading","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing","type":"topic","abstract":[{"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","isActive":true,"type":"reference","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}]}],"kind":"article","role":"article","url":"\/documentation\/roundtrip\/testing"},"doc://RoundTrip/documentation/RoundTrip":{"kind":"symbol","abstract":[{"type":"text","text":"Build requ