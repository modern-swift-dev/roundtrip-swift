ge dependency, replace "},{"type":"codeVoice","code":".product(name: \"SLHttp\", package: \"SwiftLibs\")"},{"type":"text","text":" with "},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"type":"text","text":", and update tests to import "},{"type":"codeVoice","code":"RoundTrip"},{"text":". The extracted package supports Apple platforms only, so remove any Linux target that depended on ","type":"text"},{"code":"SLHttp","type":"codeVoice"},{"text":" before adopting it.","type":"text"}]},{"inlineContent":[{"type":"text","text":"RoundTrip uses Swift 6 concurrency checking. "},{"type":"codeVoice","code":"WSSClient"},{"type":"text","text":", its factory methods, "},{"type":"codeVoice","code":"BackgroundHttpClient.init"},{"type":"text","text":", and "},{"type":"codeVoice","code":"BackgroundHttpClient.finishedTask"},{"type":"text","text":" are main-actor isolated. Call them from "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" code or cross to the main actor with "},{"type":"codeVoice","code":"await MainActor.run"},{"type":"text","text":". "},{"type":"codeVoice","code":"ApiError"},{"type":"text","text":" no longer conforms to SwiftLibs’ "},{"type":"codeVoice","code":"CapturableError"},{"type":"text","text":"; add that conformance in your application if it still uses the SwiftLibs logging protocol."}],"type":"paragraph"}]}],"references":{"doc://RoundTrip/documentation/RoundTrip/Testing":{"type":"topic","url":"\/documentation\/roundtrip\/testing","role":"article","abstract":[{"type":"reference","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","isActive":true}],"kind":"article","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing","title":"Testing with mocked URL loading"},"doc://RoundTrip/documentation/RoundTrip":{"url":"\/documentation\/roundtrip","role":"collection","abstr