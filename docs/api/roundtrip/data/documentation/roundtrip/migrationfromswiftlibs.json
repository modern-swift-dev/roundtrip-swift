{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"role":"article","title":"Migrating from SLHttp","modules":[{"name":"RoundTrip"}],"roleHeading":"Article"},"abstract":[{"type":"reference","identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"isActive":true,"overridingTitle":"Documentation index"}],"kind":"article","seeAlsoSections":[{"title":"Development","anchor":"Development","identifiers":["doc:\/\/RoundTrip\/documentation\/RoundTrip\/Testing"],"generated":true}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"RoundTrip extracts the HTTP library previously shipped as ","type":"text"},{"code":"SLHttp","type":"codeVoice"},{"text":" in SwiftLibs. Update imports and target dependencies first:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Before","import SLHttp","","\/\/ After","import RoundTrip"]},{"inlineContent":[{"text":"The primary HTTP types keep their names: ","type":"text"},{"type":"codeVoice","code":"HttpClient"},{"type":"text","text":", "},{"type":"codeVoice","code":"URLRequestBuilder"},{"type":"text","text":", "},{"type":"codeVoice","code":"URLRequestConvertible"},{"type":"text","text":", "},{"type":"codeVoice","code":"MultipartBody"},{"type":"text","text":", "},{"type":"codeVoice","code":"ApiResponse"},{"type":"text","text":", and "},{"type":"codeVoice","code":"ApiError"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"Add RoundTrip as a package dependency, replace ","type":"text"},{"type":"codeVoice","code":".product(name: \"SLHttp\", package: \"SwiftLibs\")"},{"text":" with ","type":"text"},{"type":"codeVoice","code":".product(name: \"RoundTrip\", package: \"roundtrip-swift\")"},{"text":", and update tests to import ","type":"text"},{"type":"codeVoice","code":"RoundTrip"},{"text":". The extracted package supports Apple platforms only, so remove any Linux target that depended on ","type":"text"},{"type":"codeVoice","code":"SLHttp"},{"text":" before adopting it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"RoundTrip uses Swift 6 concurrency checking. ","type":"text"},{"type":"codeVoice","code":"WSSClient"},{"text":", its factory methods, ","type":"text"},{"type":"codeVoice","code":"BackgroundHttpClient.init"},{"text":", and ","type":"text"},{"code":"BackgroundHttpClient.finishedTask","type":"codeVoice"},{"type":"text","text":" are main-actor isolated. Call them from "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" code or cross to the main actor with "},{"code":"await MainActor.run","type":"codeVoice"},{"type":"text","text":". "},{"type":"codeVoice","code":"ApiError"},{"text":" no longer conforms to SwiftLibs’ ","type":"text"},{"type":"codeVoice","code":"CapturableError"},{"text":"; add that conformance in your application if it still uses the SwiftLibs logging protocol.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/RoundTrip\/documentation\/RoundTrip"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/migrationfromswiftlibs"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/MigrationFromSwiftLibs"},"references":{"doc://RoundTrip/documentation/RoundTrip":{"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","title":"RoundTrip","abstract":[{"type":"text","text":"Build requests and perform HTTP transfers on Apple platforms."}],"url":"\/documentation\/roundtrip","type":"topic","role":"collection","kind":"symbol"},"doc://RoundTrip/documentation/RoundTrip/Testing":{"abstract":[{"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","overridingTitle":"Documentation index","overridingTitleInlineContent":[{"text":"Documentation index","type":"text"}],"isActive":true,"type":"reference"}]