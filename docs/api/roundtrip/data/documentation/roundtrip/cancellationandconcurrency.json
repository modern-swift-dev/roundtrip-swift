{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"HttpClient"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" and may be shared by concurrent tasks. Treat request values and decoded models according to their own concurrency requirements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Treat cancellation as a normal outcome when a screen or parent task goes away. Handle "},{"type":"codeVoice","code":"ApiError.cancelled"},{"type":"text","text":" or "},{"type":"codeVoice","code":"URLError.cancelled"},{"type":"text","text":" where the calling feature needs to distinguish cancellation from a failed request."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To stop all work owned by an "},{"type":"codeVoice","code":"HttpClient"},{"type":"text","text":", call "},{"type":"codeVoice","code":"invalidate()"},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"recreate: true"},{"type":"text","text":" only when you intend to use that client again after invalidating its current URL session."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"WSSClient"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BackgroundHttpClient"},{"type":"text","text":" have APIs that interact with Combine and the main actor. Receive UI updates on the main actor, and keep long-running transfer ownership outside short-lived views."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/roundtrip\/cancellationandconcurrency"]}],"abstract":[{"overridingTitleInlineContent":[{"type":"text","text":"Documentation index"}],"identifier":"doc:\/\/RoundTrip\/documentation\/RoundTrip","isActive":true,"overridingTitle":"Documentation index","type":"reference"}],"identifier":{"url":"doc:\/\/RoundTrip\/documentation\/RoundTrip\/Cancellation